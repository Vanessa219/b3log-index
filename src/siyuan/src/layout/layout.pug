include ../version.pug

block page
- var sitePages = require("../../site-pages.json");
- var page = sitePages[pageKey];
- var siteRoot = "https://b3log.org/siyuan/";
- var pagePath = (key) => key === "index" ? "" : key === "en/index" ? "en/" : key + ".html";
- var canonicalUrl = siteRoot + pagePath(pageKey);
- var relativeRoot = "../".repeat(pageKey.split("/").length - 1);
- var homeHref = relativeRoot + (page.language === "en" ? "en/" : "") || "./";
- var languageHref = relativeRoot + pagePath(page.alternate || "en/index");
- var languageIsFallback = !page.alternate;

doctype html
html(lang=page.language === "zh" ? "zh-Hans" : "en")
    head
        meta(charset="UTF-8")
        meta(http-equiv="X-UA-Compatible", content="IE=edge")
        meta(name="viewport", content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0")
        meta(name="robots", content="index,follow,archive")
        meta(name="copyright", content="B3log")
        meta(name="apple-mobile-web-app-capable" content="yes")
        meta(name="mobile-web-app-capable" content="yes")
        meta(name="apple-mobile-web-app-status-bar-style" content="black")
        meta(http-equiv="Window-target" content="_top")
        meta(property="og:locale" content=page.language === "zh" ? "zh_CN" : "en_US")
        meta(property="og:image" content="https://b3log.org/images/brand/siyuan-128.png")
        meta(property="og:url" content=canonicalUrl)
        title= page.title
        meta(name="description" content=page.description)
        meta(property="og:title" content=page.title)
        meta(property="og:description" content=page.description)
        meta(property="og:site_name" content=page.language === "zh" ? "思源笔记" : "SiYuan")
        link(rel="canonical" href=canonicalUrl)
        if page.alternate
            link(rel="alternate" hreflang=page.language === "zh" ? "zh-Hans" : "en" href=canonicalUrl)
            link(rel="alternate" hreflang=sitePages[page.alternate].language === "zh" ? "zh-Hans" : "en" href=siteRoot + pagePath(page.alternate))
        meta(name="twitter:card" content="summary_large_image")
        meta(name="twitter:title" content=page.title)
        meta(name="twitter:description" content=page.description)
        meta(name="twitter:image" content="https://b3log.org/images/brand/siyuan-128.png")
        meta(name="twitter:url" content=canonicalUrl)
        meta(name="twitter:site" content="@b3logos")
        meta(name="twitter:creator" content="@b3logos")
        link(rel="apple-touch-icon", href="https://b3log.org/images/brand/siyuan-128.png")
        link(rel="preconnect", href="https://ld246.com")
        link(rel="preconnect", href="https://release.b3log.org")
        link(rel="preconnect", href="https://github.com")
        link(rel="icon", type="image/png", href="https://b3log.org/images/brand/siyuan-128.png")
        link(rel="shortcut icon", type="image/x-icon", href="https://b3log.org/images/brand/siyuan-128.png")
        script.
            (() => {
                const isLocalBaseCssPreview = window.location.protocol === "file:" || ["localhost", "127.0.0.1", "::1"].includes(window.location.hostname);
                const isEnglishPage = window.location.pathname.includes("/en/");
                const isDistributorPage = window.location.pathname.includes("/distributors/");
                const localBaseCss = isEnglishPage || isDistributorPage ? "../../static/base.css" : "../static/base.css";
                const baseCss = isLocalBaseCssPreview ? localBaseCss : "https://b3log.org/siyuan/static/base.css";
                document.write(`<link rel="stylesheet" type="text/css" href="${baseCss}">`);
            })();
    body
        include language.pug
        script.
            const lang = !{JSON.stringify(page.language)};
        block content
        script.
            const isLocalAssetPreview = window.location.protocol === "file:" || ["localhost", "127.0.0.1", "::1"].includes(window.location.hostname);
            if (isLocalAssetPreview) {
                const isNestedAssetPage = window.location.pathname.includes("/en/") || window.location.pathname.includes("/distributors/");
                const localStaticRoot = isNestedAssetPage ? "../../static/" : "../static/";
                const remoteStaticRoot = "https://b3log.org/siyuan/static/";
                document.querySelectorAll("[src], [href]").forEach((element) => {
                    const attribute = element.hasAttribute("src") ? "src" : "href";
                    const resource = element.getAttribute(attribute);
                    if (resource && resource.startsWith(remoteStaticRoot)) {
                        element.setAttribute(attribute, localStaticRoot + resource.slice(remoteStaticRoot.length));
                    }
                });
                document.querySelectorAll("a[href]").forEach((element) => {
                    const href = element.getAttribute("href");
                    if (href && !/^(?:[a-z]+:|\/\/|#)/i.test(href) && href.endsWith("/")) {
                        element.setAttribute("href", href + "index.html");
                    }
                });
            }
        script.
            const isLocalIndexPreview = window.location.protocol === "file:" || ["localhost", "127.0.0.1", "::1"].includes(window.location.hostname);
            const isEnglishIndexPage = window.location.pathname.includes("/en/");
            const isDistributorIndexPage = window.location.pathname.includes("/distributors/");
            const localIndexScript = isEnglishIndexPage || isDistributorIndexPage ? "../../static/index.js" : "../static/index.js";
            const indexScript = document.createElement("script");
            indexScript.src = isLocalIndexPreview ? localIndexScript : "https://b3log.org/siyuan/static/index.js";
            document.body.appendChild(indexScript);
